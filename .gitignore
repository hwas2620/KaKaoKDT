# 의존성 패키지
# node_js나 yarn, pnpm 등으로 설치된 패키지는 용량이 매우 크고,
# package.json만 있으면 언제든 다시 설치할 수 있으므로 절대 올리지 않습니다.
node_modules

# 빌드 결과물
# 배포를 위해 압축되고 변환된 파일들입니다. 원본 코드로 언제든 다시 생성할 수 있습니다.
/build
/dist
/.out

# 환경 변수 파일
# API 키, 데이터베이스 비밀번호 등 민감한 정보를 담고 있으므로
# 절대 외부에 노출되어서는 안 됩니다.
.env
.env.local
.env.*.local
!/.env.example

# 로그 파일
# 실행 과정에서 생성되는 로그 파일들은 개인 환경에만 필요합니다.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# 운영체제(OS) 생성 파일
# macOS나 Windows가 자동으로 생성하는 시스템 파일입니다.
.DS_Store
Thumbs.db

# IDE 및 에디터 설정 파일
# VS Code, IntelliJ 등 개인의 에디터 설정은 프로젝트와 무관합니다.
.vscode/
.idea/

# 테스트 및 커버리지 리포트
# 테스트 실행 시 생성되는 결과물입니다.
/coverage